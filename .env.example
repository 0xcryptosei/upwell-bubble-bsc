# Copy to .env (Vite reads VITE_* variables at start-up; restart `npm run dev` after changing).

# Where the Upwell backend runs (VPS: https://45.61.176.188:7443, local: http://127.0.0.1:7726)
VITE_API_URL=http://127.0.0.1:7726

# WalletConnect (QR code / mobile wallets). Free project ID from https://dashboard.reown.com
# Add http://127.0.0.1:7725 and your production domain to the project's allowed domains.
VITE_WC_PROJECT_ID=

# 56 = BNB Chain mainnet, 97 = BNB testnet
VITE_CHAIN_ID=56


# Shown in the landing page footer. Leave empty to show "coming soon".
VITE_TOKEN_CA=
# Where to buy $UPW (e.g. its Flap.sh page)
VITE_BUY_URL=
VITE_X_URL=
VITE_TELEGRAM_URL=
